digraph "Exploration" {
    rankdir=LR;
    splines=polyline;
    node [shape=box];

    "wormhole_navigation" [label="Wormhole Navigation"];
    "jump_calibration" [label="Jump Calibration"];
    "exploration" [label="Exploration"];
    "scanning_advanced" [label="Advanced Scanning"];
    "first_contact" [label="First Contact Protocols"];
    "diplomacy" [label="Diplomacy"];
    "astrometrics" [label="Astrometrics"];
    "hazard_resistance" [label="Environmental Hazard Resistance"];
    "shields" [label="Shield Operation"];
    "cartography" [label="Cartography"];
    "anomaly_detection" [label="Anomaly Detection"];
    "anomaly_exploitation" [label="Anomaly Exploitation"];
    "survey" [label="Survey"];
    "scanning" [label="Scanning"];

    { rank=same; "exploration"; "diplomacy"; "shields"; "scanning"; }
    { rank=same; "jump_calibration"; "scanning_advanced"; "first_contact"; "astrometrics"; "hazard_resistance"; "survey"; }
    { rank=same; "wormhole_navigation"; "cartography"; "anomaly_detection"; }
    { rank=same; "anomaly_exploitation"; }

    "exploration" -> "first_contact" [label="5"];
    "diplomacy" -> "first_contact" [label="3" color=gray50];
    "exploration" -> "astrometrics" [label="5"];
    "exploration" -> "hazard_resistance" [label="5"];
    "shields" -> "hazard_resistance" [label="3" color=gray50];
    "astrometrics" -> "cartography" [label="3"];
    "anomaly_detection" -> "anomaly_exploitation" [label="5"];
    "scanning" -> "survey" [label="3" color=gray50];
    "exploration" -> "survey" [label="3"];
    "jump_calibration" -> "wormhole_navigation" [label="5" color=gray50];
    "astrometrics" -> "wormhole_navigation" [label="5"];
    "exploration" -> "anomaly_detection" [label="5"];
    "scanning_advanced" -> "anomaly_detection" [label="3" color=gray50];
}
