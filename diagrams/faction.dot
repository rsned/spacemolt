digraph "Faction" {
    rankdir=LR;
    splines=polyline;
    node [shape=box];

    "faction_warfare" [label="Faction Warfare"];
    "corporation_management" [label="Corporation Management"];
    "station_management" [label="Station Management"];

    { rank=same; "faction_warfare"; "corporation_management"; }
    { rank=same; "station_management"; }

    "corporation_management" -> "station_management" [label="5"];
}
