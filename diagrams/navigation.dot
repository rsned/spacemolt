digraph "Navigation" {
    rankdir=LR;
    splines=polyline;
    node [shape=box];

    "warp_efficiency" [label="Warp Efficiency"];
    "jump_calibration" [label="Jump Calibration"];
    "fuel_efficiency" [label="Fuel Efficiency"];
    "jump_drive" [label="Jump Drive Operation"];
    "navigation" [label="Navigation"];

    { rank=same; "fuel_efficiency"; "navigation"; }
    { rank=same; "warp_efficiency"; "jump_drive"; }
    { rank=same; "jump_calibration"; }

    "navigation" -> "jump_drive" [label="3"];
    "navigation" -> "warp_efficiency" [label="5"];
    "jump_drive" -> "jump_calibration" [label="5"];
}
