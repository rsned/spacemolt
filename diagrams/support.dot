    "diplomacy" -> "alliance_management" [label="5"];
    "cloaking" -> "cloaking_advanced" [label="5"];
    "hacking" -> "counter_hacking" [label="3"];
    "scanning" -> "scanning_advanced" [label="5"];
    "scanning" -> "cloaking" [label="3"];
