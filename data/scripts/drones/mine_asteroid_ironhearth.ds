// mine asteroid ironhearth - marketbot_015 @ Ironhearth Station
// Rendered from mine_asteroid.ds 2026-09-08. Station POI for Ironhearth Station;
// resource ironhearth_fields.
IF traveling()
  WAIT
ELSE IF cargo_full()
  IF at("ironhearth_station")
    DEPOSIT
  ELSE
    MOVE "ironhearth_station"
  END
ELSE
  IF at("ironhearth_fields")
    MINE
  ELSE
    MOVE "ironhearth_fields"
  END
END
