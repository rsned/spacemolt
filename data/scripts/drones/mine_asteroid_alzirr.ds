// mine asteroid alzirr - marketbot_010 @ Event Horizon Relay
// Rendered from mine_asteroid.ds 2026-09-08. Station is the POI id for
// Event Horizon Relay; belt is Alzirr Belt.
IF traveling()
  WAIT
ELSE IF cargo_full()
  IF at("b6007ea0d1b905492a17dcd5d3e72286")
    DEPOSIT
  ELSE
    MOVE "b6007ea0d1b905492a17dcd5d3e72286"
  END
ELSE
  IF at("alzirr_belt")
    MINE
  ELSE
    MOVE "alzirr_belt"
  END
END
