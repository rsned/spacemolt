// marketbot_ramens_rest at kornephoros: retargeted 2026-11-22 off a POI whose main output sits at the
// 100k personal-storage cap (v0.732.4). Mines kornephoros_frost_ring, deposits at the host
// station POI 91b887ed660acdcdc166e1e659c43ba0.
IF traveling()
  WAIT
ELSE IF cargo_full()
  IF at("91b887ed660acdcdc166e1e659c43ba0")
    DEPOSIT
  ELSE
    MOVE "91b887ed660acdcdc166e1e659c43ba0"
  END
ELSE
  IF at("kornephoros_frost_ring")
    MINE
  ELSE
    MOVE "kornephoros_frost_ring"
  END
END
