// marketbot_005 at saiph: retargeted 2026-11-22 off a POI whose main output sits at the
// 100k personal-storage cap (v0.732.4). Mines saiph_emission_nebula, deposits at the host
// station POI f9a69fe2de7833d14270f634f46622ae.
IF traveling()
  WAIT
ELSE IF cargo_full()
  IF at("f9a69fe2de7833d14270f634f46622ae")
    DEPOSIT
  ELSE
    MOVE "f9a69fe2de7833d14270f634f46622ae"
  END
ELSE
  IF at("saiph_emission_nebula")
    MINE
  ELSE
    MOVE "saiph_emission_nebula"
  END
END
