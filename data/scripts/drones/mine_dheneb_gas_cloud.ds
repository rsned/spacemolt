// marketbot_001 at dheneb: retargeted 2026-11-22 off a POI whose main output sits at the
// 100k personal-storage cap (v0.732.4). Mines dheneb_gas_cloud, deposits at the host
// station POI 98eba8b1a7ad0520d6a7c8ea44b2d6aa.
IF traveling()
  WAIT
ELSE IF cargo_full()
  IF at("98eba8b1a7ad0520d6a7c8ea44b2d6aa")
    DEPOSIT
  ELSE
    MOVE "98eba8b1a7ad0520d6a7c8ea44b2d6aa"
  END
ELSE
  IF at("dheneb_gas_cloud")
    MINE
  ELSE
    MOVE "dheneb_gas_cloud"
  END
END
