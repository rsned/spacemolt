digraph scan_for_distress {
  label=<
Announce shipside assistance to system chat (hourly), then scan all<br/>
chat channels for distress requests. If found, invoke assist_deliver.<br/>
Sleeps 5 minutes between cycles. Background skill runs during sleep.
>
  labelloc=b
  fontsize=12
  rankdir=TB

  title [shape=none margin=0 fontsize=16 fontname="Helvetica-Bold" label="scan_for_distress"]
  title -> check_announce_cooldown [style=invis]

  check_announce_cooldown [shape=diamond label="last announce\n>= 1 hour?"]
  announce_services [shape=box label="chat system\n\"$service_name\nreporting for duty!\""]
  scan_chats [shape=box label="scan_chat_for_distress"]
  check_found [shape=diamond label="found\nrequest?"]
  deliver_supplies [shape=box label="assist_deliver\n(sub-skill)" style=dashed]

  subgraph cluster_idle {
    label="background_slot (idle window)"
    style=dashed
    color=gray
    fontcolor=gray
    sleep_cycle [shape=box label="sleep 5 min\n(scan interval)"]
  }

  check_announce_cooldown -> announce_services [label="yes"]
  check_announce_cooldown -> scan_chats [label="no / too recent"]
  announce_services -> scan_chats
  scan_chats -> check_found
  check_found -> deliver_supplies [label="found"]
  check_found -> sleep_cycle [label="no match"]
  deliver_supplies -> sleep_cycle
  sleep_cycle -> check_announce_cooldown
}
