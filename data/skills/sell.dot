digraph sell {
  label=<
Sell all cargo at the current station. Must be docked.
>
  labelloc=b
  fontsize=12
  rankdir=TB

  title [shape=none margin=0 fontsize=16 fontname="Helvetica-Bold" label="sell"]
  title -> check_docked [style=invis]

  check_docked [shape=diamond label="check_docked"]
  sell_all [shape=box label="sell"]
  done [shape=doublecircle label="done"]

  check_docked -> done [label="not docked"]
  check_docked -> done [label="not has_cargo"]
  check_docked -> sell_all [label="default"]
  sell_all -> done
}
