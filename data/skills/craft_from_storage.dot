digraph craft_from_storage {
  label=<
Craft items using materials from station storage.<br/>
Deposits current cargo, queries craftable recipes from storage contents,<br/>
withdraws materials, crafts, and deposits outputs.<br/>
Repeats until nothing more can be crafted.
>
  labelloc=b
  fontsize=12
  rankdir=TB

  title [shape=none margin=0 fontsize=16 fontname="Helvetica-Bold" label="craft_from_storage"]
  title -> check_ready [style=invis]

  check_ready [shape=diamond label="check_ready"]
  craft [shape=box label="craft_from_storage"]
  done [shape=doublecircle label="done"]

  check_ready -> done [label="not docked"]
  check_ready -> done [label="not at_poi_type(station)"]
  check_ready -> craft [label="default"]
  craft -> done
}
