digraph craft_items {
  label=<
Craft all possible items from current cargo. Queries the<br/>
crafting MCP server to determine which recipes can be crafted with<br/>
available resources and skills, then crafts them in batched quantities.<br/>
Must be docked with cargo on board.
>
  labelloc=b
  fontsize=12
  rankdir=TB

  title [shape=none margin=0 fontsize=16 fontname="Helvetica-Bold" label="craft_items"]
  title -> check_ready [style=invis]

  check_ready [shape=diamond label="check_ready"]
  craft [shape=box label="craft_from_cargo"]
  done [shape=doublecircle label="done"]

  check_ready -> done [label="not docked"]
  check_ready -> done [label="not at_poi_type(station)"]
  check_ready -> done [label="not has_cargo"]
  check_ready -> craft [label="default"]
  craft -> done
}
