digraph craft_items {
  label=<
Craft items from station storage and ship cargo. Deposits cargo<br/>
to storage, queries craftable recipes from the combined pool,<br/>
withdraws materials, crafts in batches, and deposits results.<br/>
Repeats until nothing more can be crafted.
>
  labelloc=b
  fontsize=12
  rankdir=TB

  title [shape=none margin=0 fontsize=16 fontname="Helvetica-Bold" label="craft_items"]
  title -> check_ready [style=invis]

  check_ready [shape=diamond label="check_ready"]
  craft [shape=box label="craft_items"]
  done [shape=doublecircle label="done"]

  check_ready -> done [label="not docked"]
  check_ready -> done [label="not at_poi_type(station)"]
  check_ready -> craft [label="default"]
  craft -> done
}
