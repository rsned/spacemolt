# data/scripts/ holds the curated shared catalog scripts (tracked) alongside
# local/experimental scripts (ignored). Ignore all .smolt, then re-include only
# the catalog files so a blanket `git add -A` can't re-track local scripts.
!data/scripts/
data/scripts/*.smolt
!data/scripts/idle_mine.smolt
!data/scripts/track_station.smolt
/wiki/
*.backup
# DB snapshots / gzipped knowledge-base backups — never commit
/data/backups/
*.db.gz
/cmd/tools/daily-summary/FACTION_PLAN.md

